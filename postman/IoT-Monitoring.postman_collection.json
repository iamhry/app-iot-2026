    },
    {
      "name": "Metode salah",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 405', function () { pm.response.to.have.status(405); });"] } }],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{device_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"device_id\":\"{{device_id}}\",\"temperature\":26.5,\"humidity\":65.2}" },
        "url": "{{base_url}}/api/v1/readings.php"
      }
    },
    {
      "name": "GET device",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('hanya identitas sendiri', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.device_id).to.eql(pm.environment.get('device_id'));",
              "  pm.expect(body.data).to.not.have.property('token_hash');",
              "  pm.expect(body.data).to.not.have.property('token');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{device_token}}" }],
        "url": "{{base_url}}/api/v1/device.php"
      }
    },
    {
      "name": "GET latest",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200 atau 404', function () { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });"] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{device_token}}" }],
        "url": "{{base_url}}/api/v1/latest.php"
      }
    },
    {
      "name": "Rate limit",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const url = pm.environment.get('base_url') + '/api/v1/readings.php';",
              "const token = pm.environment.get('device_token');",
              "const deviceId = pm.environment.get('device_id');",
              "for (let i = 0; i < 35; i++) {",
              "  await new Promise((resolve) => {",
              "    pm.sendRequest({",
              "      url: url,",
              "      method: 'POST',",
              "      header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },",
              "      body: { mode: 'raw', raw: JSON.stringify({ device_id: deviceId, temperature: 26.5, humidity: 60 }) }",
              "    }, function () { resolve(); });",
              "  });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 429', function () { pm.response.to.have.status(429); });"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{device_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"temperature\": 26.5,\n  \"humidity\": 60\n}" },
        "url": "{{base_url}}/api/v1/readings.php",
        "description": "Mengirim lebih dari 30 permintaan dalam 60 detik. Butuh Postman yang mendukung await di pre-request script. Jalankan terpisah karena menghabiskan kuota perangkat."
      }
    }
  ]
